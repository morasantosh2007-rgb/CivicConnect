# ==========================================
# CivicConnect Environment Configuration
# ==========================================

# Project Info
PROJECT_NAME="CivicConnect"
API_V1_STR="/api/v1"
PORT=8000
HOST="127.0.0.1"

# Database Configuration (SQLite with WAL mode by default)
DATABASE_PATH="backend/app/data/civicconnect.db"

# Security & JWT Tokens
SECRET_KEY="replace-this-with-a-cryptographically-secure-random-token-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & Language Models (Google Gemini)
# Obtain from https://aistudio.google.com/
# If unconfigured, CivicConnect falls back to official local grounded RAG with zero dummy data
GEMINI_API_KEY=""

# DigiLocker Requester/Partner API Integration (MeitY)
# Obtain from https://partners.digitallocker.gov.in/
# If unconfigured, CivicConnect honestly displays pending status and enables verified manual profile entry fallback
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
DIGILOCKER_REDIRECT_URI="http://localhost:5173/profile?digilocker_callback=true"

# Official Data Ingestion Sources
PIB_RSS_PRESS_RELEASES="https://pib.gov.in/RssMain.aspx?ModId=6"
PIB_RSS_FACT_CHECK="https://pib.gov.in/RssFactCheck.aspx"
MYSCHEME_PORTAL_URL="https://www.myscheme.gov.in/"
DATA_GOV_IN_URL="https://data.gov.in/"

# Regional Languages Supported
SUPPORTED_LANGUAGES="en,te,hi,ta,kn"
DEFAULT_LANGUAGE="en"

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=true
